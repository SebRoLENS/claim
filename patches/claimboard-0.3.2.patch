new file mode 100644
index 0000000..6ed2fb2
--- /dev/null
+++ project-032/src/it/claimboard/scanner/DiagnosticAnonymizer.java
@@ -0,0 +1,125 @@
+package it.claimboard.scanner;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Funzioni pure usate per creare un log condivisibile senza dati identificativi. */
+final class DiagnosticAnonymizer {
+    private static final Pattern URL = Pattern.compile("(?i)\\b(?:https?://|www\\.)\\S+");
+    private static final Pattern EMAIL = Pattern.compile(
+        "(?i)(?<![\\w.+-])[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}(?![\\w.-])");
+    private static final Pattern HANDLE = Pattern.compile(
+        "(?i)(?<![\\p{L}\\d._])@[A-Z0-9_][A-Z0-9_.-]{2,}");
+    private static final Pattern IP_ADDRESS = Pattern.compile(
+        "(?<!\\d)(?:\\d{1,3}\\.){3}\\d{1,3}(?!\\d)");
+    private static final Pattern UNIX_PATH = Pattern.compile(
+        "(?i)(?<![\\p{L}\\d])(?:/[A-Z0-9._ -]+){2,}(?:/[A-Z0-9._ -]+)?");
+    private static final Pattern WINDOWS_PATH = Pattern.compile(
+        "(?i)\\b[A-Z]:\\\\(?:[^\\s\\\\]+\\\\)+[^\\s\\\\]*");
+    private static final Pattern PHONE = Pattern.compile(
+        "(?<![\\p{L}\\d])\\+?\\d(?:[\\s()./-]*\\d){7,}(?![\\p{L}\\d])");
+    private static final Pattern LONG_NUMBER = Pattern.compile("(?<!\\d)\\d{7,}(?!\\d)");
+
+    private DiagnosticAnonymizer() {}
+
+    static Map<String, String> buildAliases(List<String> names) {
+        Set<String> unique = new LinkedHashSet<String>();
+        if (names != null) {
+            for (String value : names) {
+                String clean = value == null ? "" : value.trim();
+                if (clean.length() == 0 || isOperator(clean)) continue;
+                boolean present = false;
+                for (String known : unique) {
+                    if (known.equalsIgnoreCase(clean)) {
+                        present = true;
+                        break;
+                    }
+                }
+                if (!present) unique.add(clean);
+            }
+        }
+        List<String> sorted = new ArrayList<String>(unique);
+        Collections.sort(sorted, new Comparator<String>() {
+            @Override
+            public int compare(String left, String right) {
+                int value = left.compareToIgnoreCase(right);
+                return value != 0 ? value : left.compareTo(right);
+            }
+        });
+        Map<String, String> result = new LinkedHashMap<String, String>();
+        int index = 1;
+        for (String name : sorted) {
+            result.put(name, String.format(Locale.US, "Cliente_%03d", index++));
+        }
+        return result;
+    }
+
+    static String aliasFor(String name, Map<String, String> aliases) {
+        String clean = name == null ? "" : name.trim();
+        if (clean.length() == 0) return "Sconosciuto";
+        if (isOperator(clean)) return "Operatore";
+        if (aliases != null) {
+            for (Map.Entry<String, String> entry : aliases.entrySet()) {
+                if (entry.getKey().equalsIgnoreCase(clean)) return entry.getValue();
+            }
+            String created = String.format(Locale.US, "Cliente_%03d", aliases.size() + 1);
+            aliases.put(clean, created);
+            return created;
+        }
+        return "Cliente_sconosciuto";
+    }
+
+    static String sanitizeText(String value, Map<String, String> aliases) {
+        if (value == null || value.length() == 0) return "";
+        String result = value;
+        List<Map.Entry<String, String>> entries = new ArrayList<Map.Entry<String, String>>();
+        if (aliases != null) entries.addAll(aliases.entrySet());
+        Collections.sort(entries, new Comparator<Map.Entry<String, String>>() {
+            @Override
+            public int compare(Map.Entry<String, String> left, Map.Entry<String, String> right) {
+                return right.getKey().length() - left.getKey().length();
+            }
+        });
+        for (Map.Entry<String, String> entry : entries) {
+            String raw = entry.getKey();
+            if (raw.length() == 0) continue;
+            String expression = raw.length() <= 2
+                ? "(?iu)(?<![\\p{L}\\d])" + Pattern.quote(raw) + "(?![\\p{L}\\d])"
+                : "(?iu)" + Pattern.quote(raw);
+            result = Pattern.compile(expression).matcher(result)
+                .replaceAll(Matcher.quoteReplacement(entry.getValue()));
+        }
+        result = Pattern.compile("(?iu)(?<![\\p{L}\\d])Tu(?![\\p{L}\\d])")
+            .matcher(result).replaceAll("Operatore");
+        result = URL.matcher(result).replaceAll("[URL]");
+        result = EMAIL.matcher(result).replaceAll("[EMAIL]");
+        result = HANDLE.matcher(result).replaceAll("[HANDLE]");
+        result = IP_ADDRESS.matcher(result).replaceAll("[IP]");
+        result = WINDOWS_PATH.matcher(result).replaceAll("[PATH]");
+        result = UNIX_PATH.matcher(result).replaceAll("[PATH]");
+        result = PHONE.matcher(result).replaceAll("[PHONE]");
+        result = LONG_NUMBER.matcher(result).replaceAll("[NUMBER]");
+        return result;
+    }
+
+    static String sanitizeLotText(String value, Map<String, String> aliases, String lotId) {
+        if (value == null) return "";
+        if (lotId == null || lotId.length() == 0) return sanitizeText(value, aliases);
+        String marker = "__CLAIMBOARD_LOT_IDENTIFIER__";
+        String prepared = value.replace(lotId, marker);
+        return sanitizeText(prepared, aliases).replace(marker, lotId);
+    }
+
+    private static boolean isOperator(String value) {
+        return "tu".equals(value.trim().toLowerCase(Locale.ITALY));
+    }
+}

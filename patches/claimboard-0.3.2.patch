diff --git project-032/tests/it/claimboard/scanner/DiagnosticAnonymizerTest.java project-032/tests/it/claimboard/scanner/DiagnosticAnonymizerTest.java
new file mode 100644
index 0000000..1180ab0
--- /dev/null
+++ project-032/tests/it/claimboard/scanner/DiagnosticAnonymizerTest.java
@@ -0,0 +1,57 @@
+package it.claimboard.scanner;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+public final class DiagnosticAnonymizerTest {
+    public static void main(String[] args) {
+        List<String> names = new ArrayList<String>();
+        names.add("Mario Rossi");
+        names.add("Giulia");
+        names.add("mario rossi");
+        names.add("+39 351 717 1630");
+        names.add("Tu");
+        Map<String, String> aliases = DiagnosticAnonymizer.buildAliases(names);
+
+        require(aliases.size() == 3, "alias unici e case-insensitive");
+        require("Cliente_003".equals(DiagnosticAnonymizer.aliasFor("Mario Rossi", aliases)),
+            "alias stabile per nome");
+        require("Cliente_001".equals(
+            DiagnosticAnonymizer.aliasFor("+39 351 717 1630", aliases)),
+            "numero WhatsApp trattato come partecipante");
+        require("Operatore".equals(DiagnosticAnonymizer.aliasFor("Tu", aliases)),
+            "operatore separato");
+
+        String raw = "Mario Rossi, +39 333 123 4567, mario@example.it, "
+            + "https://example.it/ordine, @mario_cards, 192.168.1.20, "
+            + "/data/user/0/app/file e C:\\Users\\Mario\\debug.txt";
+        String clean = DiagnosticAnonymizer.sanitizeText(raw, aliases);
+        require(clean.contains("Cliente_003"), "nome sostituito");
+        require(clean.contains("[PHONE]"), "telefono rimosso");
+        require(clean.contains("[EMAIL]"), "email rimossa");
+        require(clean.contains("[URL]"), "url rimosso");
+        require(clean.contains("[HANDLE]") && clean.contains("[IP]"),
+            "handle e indirizzo IP rimossi");
+        require(clean.contains("[PATH]"), "percorsi file rimossi");
+        require(!clean.contains("Mario") && !clean.contains("333"),
+            "nessun identificatore residuo");
+
+        String business = DiagnosticAnonymizer.sanitizeText(
+            "Lotto 094, Claim min 18.00 €, Claim max 20.00 €", aliases);
+        require(business.contains("094") && business.contains("18.00")
+            && business.contains("20.00"), "lotto breve e prezzi conservati");
+        require(DiagnosticAnonymizer.sanitizeText("3517171630", aliases).contains("[PHONE]"),
+            "numero lungo libero rimosso");
+        String longLot = "015038127180";
+        String caption = DiagnosticAnonymizer.sanitizeLotText(
+            "Lotto " + longLot + " Claim min 18 Claim max 20", aliases, longLot);
+        require(caption.contains(longLot), "identificativo lotto lungo conservato nel contesto lotto");
+
+        System.out.println("DiagnosticAnonymizerTest: controlli superati");
+    }
+
+    private static void require(boolean condition, String message) {
+        if (!condition) throw new AssertionError(message);
+    }
+}

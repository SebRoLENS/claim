+package it.claimboard.scanner;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.view.accessibility.AccessibilityNodeInfo;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStreamWriter;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+import java.util.TimeZone;
+
+/** Log diagnostico privato: ogni chiamata è best effort e non blocca il resoconto. */
+final class DiagnosticLog {
+    private static final String FILE_NAME = "claimboard_diagnostic.jsonl";
+    private static final String KEY_SNAPSHOTS = "diagnostic_snapshots";
+    private static final String KEY_EVENT_COUNT = "diagnostic_event_count";
+    private static final long MAX_BYTES = 12L * 1024L * 1024L;
+    private static final int MAX_SNAPSHOTS = 8;
+    private static final int MAX_SNAPSHOT_NODES = 350;
+
+    private DiagnosticLog() {}
+
+    static File file(Context context) {
+        return new File(context.getFilesDir(), FILE_NAME);
+    }
+
+    static synchronized void start(Context context, String session) {
+        File destination = file(context);
+        try {
+            if (destination.exists()) {
+                try (FileOutputStream ignored = new FileOutputStream(destination, false)) {
+                    // Tronca il vecchio log prima di iniziare il nuovo evento.
+                }
+            }
+            ClaimDataStore.prefs(context).edit()
+                .putInt(KEY_SNAPSHOTS, 0)
+                .putInt(KEY_EVENT_COUNT, 0)
+                .apply();
+            JSONObject data = new JSONObject();
+            data.put("schema", 1);
+            data.put("appVersion", appVersion(context));
+            data.put("session", session == null ? "" : session);
+            append(context, "session_started", data);
+        } catch (Exception ignored) {
+            // Il resoconto operativo deve continuare anche se il log non è disponibile.
+        }
+    }
+
+    static synchronized void event(Context context, String type, String message) {
+        try {
+            JSONObject data = new JSONObject();
+            data.put("message", message == null ? "" : message);
+            append(context, type, data);
+        } catch (Exception ignored) {
+            // Best effort.
+        }
+    }
+
+    static synchronized void event(Context context, String type, JSONObject data) {
+        try {
+            append(context, type, data == null ? new JSONObject() : data);
+        } catch (Exception ignored) {
+            // Best effort.
+        }
+    }
+
+    static synchronized void error(Context context, String area, Exception exception) {
+        try {
+            JSONObject data = new JSONObject();
+            data.put("area", area == null ? "" : area);
+            data.put("exception", exception == null ? "" : exception.getClass().getSimpleName());
+            data.put("message", exception == null || exception.getMessage() == null
+                ? "" : exception.getMessage());
+            append(context, "error", data);
+        } catch (Exception ignored) {
+            // Best effort.
+        }
+    }
+
+    static synchronized void failureSnapshot(Context context, String label,
+                                             AccessibilityNodeInfo root) {
+        if (root == null) return;
+        int count = ClaimDataStore.prefs(context).getInt(KEY_SNAPSHOTS, 0);
+        if (count >= MAX_SNAPSHOTS || file(context).length() >= MAX_BYTES) return;
+        try {
+            JSONArray nodes = new JSONArray();
+            SnapshotCounter counter = new SnapshotCounter();
+            collectNodes(root, nodes, counter, -1, 0);
+            JSONObject data = new JSONObject();
+            data.put("label", label == null ? "" : label);
+            data.put("nodeCount", nodes.length());
+            data.put("truncated", counter.nextIndex >= MAX_SNAPSHOT_NODES);
+            data.put("nodes", nodes);
+            append(context, "accessibility_failure_snapshot", data);
+            ClaimDataStore.prefs(context).edit().putInt(KEY_SNAPSHOTS, count + 1).apply();
+        } catch (Exception exception) {
+            error(context, "failure_snapshot", exception);
+        }
+    }
+
+    static synchronized JSONArray readEvents(Context context) {
+        JSONArray result = new JSONArray();
+        File source = file(context);
+        if (!source.exists()) return result;
+        try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+            new FileInputStream(source), StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.trim().length() == 0) continue;
+                try {
+                    result.put(new JSONObject(line));
+                } catch (Exception ignored) {
+                    JSONObject damaged = new JSONObject();
+                    damaged.put("type", "damaged_log_line");
+                    result.put(damaged);
+                }
+            }
+        } catch (Exception exception) {
+            try {
+                JSONObject error = new JSONObject();
+                error.put("type", "log_read_error");
+                error.put("message", exception.getClass().getSimpleName());
+                result.put(error);
+            } catch (Exception ignored) {
+                // JSONArray resta comunque valido.
+            }
+        }
+        if (source.length() >= MAX_BYTES) {
+            try {
+                JSONObject limit = new JSONObject();
+                limit.put("type", "diagnostic_log_limit_reached");
+                result.put(limit);
+            } catch (Exception ignored) {
+                // Best effort.
+            }
+        }
+        return result;
+    }
+
+    static synchronized void clear(Context context) throws Exception {
+        File destination = file(context);
+        if (destination.exists()) {
+            try (FileOutputStream ignored = new FileOutputStream(destination, false)) {
+                // Prima azzera il contenuto, poi prova a rimuovere il file vuoto.
+            }
+            if (!destination.delete()) {
+                throw new IllegalStateException("Impossibile cancellare il log diagnostico locale");
+            }
+        }
+        ClaimDataStore.prefs(context).edit()
+            .remove(KEY_SNAPSHOTS)
+            .remove(KEY_EVENT_COUNT)
+            .apply();
+    }
+
+    static String appVersion(Context context) {
+        try {
+            String value = context.getPackageManager()
+                .getPackageInfo(context.getPackageName(), 0).versionName;
+            return value == null ? "unknown" : value;
+        } catch (Exception ignored) {
+            return "unknown";
+        }
+    }
+
+    private static void append(Context context, String type, JSONObject data) throws Exception {
+        File destination = file(context);
+        if (destination.length() >= MAX_BYTES) return;
+        JSONObject line = new JSONObject();
+        line.put("index", countLinesHint(context));
+        line.put("capturedAt", isoTimestamp());
+        line.put("type", type == null ? "event" : type);
+        line.put("data", data);
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+            new FileOutputStream(destination, true), StandardCharsets.UTF_8))) {
+            writer.write(line.toString());
+            writer.newLine();
+        }
+    }
+
+    private static int countLinesHint(Context context) {
+        int value = ClaimDataStore.prefs(context).getInt(KEY_EVENT_COUNT, 0) + 1;
+        ClaimDataStore.prefs(context).edit().putInt(KEY_EVENT_COUNT, value).apply();
+        return value;
+    }
+
+    private static void collectNodes(AccessibilityNodeInfo node, JSONArray result,
+                                     SnapshotCounter counter, int parent, int depth) throws Exception {
+        if (node == null || depth > 45 || counter.nextIndex >= MAX_SNAPSHOT_NODES) return;
+        int index = counter.nextIndex++;
+        Rect bounds = new Rect();
+        node.getBoundsInScreen(bounds);
+        JSONObject item = new JSONObject();
+        item.put("i", index);
+        item.put("p", parent);
+        item.put("d", depth);
+        String id = safe(node.getViewIdResourceName());
+        String className = safe(node.getClassName());
+        String text = safe(node.getText());
+        String description = safe(node.getContentDescription());
+        if (id.length() > 0) item.put("id", id);
+        if (className.length() > 0) item.put("class", className);
+        if (text.length() > 0) item.put("text", text);
+        if (description.length() > 0) item.put("description", description);
+        item.put("bounds", bounds.left + "," + bounds.top + ","
+            + bounds.right + "," + bounds.bottom);
+        if (node.isClickable()) item.put("clickable", true);
+        if (node.isScrollable()) item.put("scrollable", true);
+        result.put(item);
+
+        int childCount = node.getChildCount();
+        for (int i = 0; i < childCount && counter.nextIndex < MAX_SNAPSHOT_NODES; i++) {
+            AccessibilityNodeInfo child = node.getChild(i);
+            if (child == null) continue;
+            try {
+                collectNodes(child, result, counter, index, depth + 1);
+            } finally {
+                child.recycle();
+            }
+        }
+    }
+
+    private static String isoTimestamp() {
+        SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'", Locale.US);
+        format.setTimeZone(TimeZone.getTimeZone("UTC"));
+        return format.format(new Date());
+    }
+
+    private static String safe(CharSequence value) {
+        return value == null ? "" : value.toString();
+    }
+
+    private static final class SnapshotCounter {
+        int nextIndex;
+    }
+}

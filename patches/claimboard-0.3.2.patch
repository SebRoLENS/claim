+
+        JSONArray buyers = new JSONArray();
+        for (CustomerResult customer : report.customers) {
+            JSONObject buyer = new JSONObject();
+            buyer.put("participant", DiagnosticAnonymizer.aliasFor(customer.name, aliases));
+            buyer.put("totalCents", customer.totalCents);
+            JSONArray purchases = new JSONArray();
+            for (Purchase purchase : customer.purchases) {
+                JSONObject item = new JSONObject();
+                item.put("lotId", purchase.lotId);
+                item.put("title", DiagnosticAnonymizer.sanitizeLotText(
+                    purchase.title, aliases, purchase.lotId));
+                item.put("cents", purchase.cents);
+                item.put("method", purchase.method);
+                item.put("time", purchase.time);
+                item.put("note", DiagnosticAnonymizer.sanitizeLotText(
+                    purchase.note, aliases, purchase.lotId));
+                purchases.put(item);
+            }
+            buyer.put("purchases", purchases);
+            buyers.put(buyer);
+        }
+        output.put("buyersOutput", buyers);
+        output.put("automationTrace", sanitizeDiagnosticValue(events, aliases));
+
+        ContentResolver resolver = context.getContentResolver();
+        OutputStream raw = resolver.openOutputStream(uri, "wt");
+        if (raw == null) throw new IllegalStateException("Destinazione non disponibile");
+        try (BufferedWriter writer = new BufferedWriter(new OutputStreamWriter(
+            raw, StandardCharsets.UTF_8))) {
+            writer.write(output.toString(2));
+            writer.newLine();
+        }
+        DiagnosticLog.event(context, "anonymized_diagnostic_exported",
+            "Esportazione completata");
+    }
+
+    private static JSONObject anonymizedLot(Context context, JSONObject lot,
+                                             Map<String, String> aliases,
+                                             Map<String, String> dayAliases) throws Exception {
+        JSONObject result = new JSONObject();
+        String lotId = lot.optString("id", "");
+        int minCents = lot.optInt("minCents", 0);
+        int maxCents = lot.optInt("maxCents", 0);
+        result.put("lotId", lotId);
+        result.put("title", DiagnosticAnonymizer.sanitizeLotText(
+            lot.optString("title", ""), aliases, lotId));
+        result.put("caption", DiagnosticAnonymizer.sanitizeLotText(
+            lot.optString("caption", ""), aliases, lotId));
+        result.put("minCents", minCents);
+        result.put("maxCents", maxCents);
+        result.put("each", lot.optBoolean("each", false));
+        result.put("declaredReplyCount", lot.optInt("replyCount", 0));
+        result.put("automationProcessed", ClaimDataStore.isAutoProcessed(context, lotId));
+
+        JSONArray commentsOutput = new JSONArray();
+        JSONArray comments = lot.optJSONArray("comments");
+        if (comments != null) {
+            for (int i = 0; i < comments.length(); i++) {
+                JSONObject comment = comments.optJSONObject(i);
+                if (comment == null) continue;
+                String name = comment.optString("name", "");
+                String text = comment.optString("text", "");
+                boolean deleted = comment.optBoolean("deleted", false);
+                JSONObject item = new JSONObject();
+                item.put("order", comment.optLong("sequence", i + 1L));
+                item.put("participant", DiagnosticAnonymizer.aliasFor(name, aliases));
+                item.put("text", DiagnosticAnonymizer.sanitizeLotText(text, aliases, lotId));
+                item.put("time", comment.optString("time", ""));
+                String day = comment.optString("date", "");
+                if (day.length() > 0) item.put("day", dayAlias(day, dayAliases));
+                item.put("deleted", deleted);
+
+                JSONObject interpretation = new JSONObject();
+                if (deleted) {
+                    interpretation.put("status", "deleted");
+                } else if (name.length() == 0 || name.equalsIgnoreCase("Tu")) {
+                    interpretation.put("status", "ignored");
+                    interpretation.put("reason", name.length() == 0
+                        ? "partecipante non riconosciuto" : "messaggio dell’operatore");
+                } else {
+                    ClaimParser.OfferDecision decision = ClaimParser.parseOffer(
+                        text, minCents, maxCents);
+                    interpretation.put("status", decision.valid ? "valid"
+                        : (decision.review ? "review" : "ignored"));
+                    if (decision.valid) {
+                        interpretation.put("cents", decision.cents);
+                        interpretation.put("method", decision.method);
+                    }
+                    if (decision.note.length() > 0) {
+                        interpretation.put("note",
+                            DiagnosticAnonymizer.sanitizeText(decision.note, aliases));
+                    }
+                }
+                item.put("parserInterpretation", interpretation);
+                commentsOutput.put(item);
+            }
+        }
+        result.put("capturedReplyCount", commentsOutput.length());
+        result.put("comments", commentsOutput);
+
+        LotResult evaluated = evaluateLot(lot);
+        if (evaluated.winner != null) {
+            JSONObject winner = new JSONObject();
+            winner.put("participant",
+                DiagnosticAnonymizer.aliasFor(evaluated.winner.name, aliases));
+            winner.put("cents", evaluated.winner.cents);
+            winner.put("method", evaluated.winner.method);
+            winner.put("time", evaluated.winner.time);
+            winner.put("winningRule", "highest offer; earliest response on tie");
+            result.put("winner", winner);
+        }
+        result.put("needsReview", evaluated.needsReview);
+        if (evaluated.reviewNote.length() > 0) {
+            result.put("reviewNote",
+                DiagnosticAnonymizer.sanitizeLotText(evaluated.reviewNote, aliases, lotId));
+        }
+        return result;
+    }
+
+    private static String dayAlias(String raw, Map<String, String> aliases) {
+        String known = aliases.get(raw);
+        if (known != null) return known;
+        String created = "Giorno_" + (aliases.size() + 1);
+        aliases.put(raw, created);
+        return created;
+    }
+
+    private static String autoStageLabel(int stage) {
+        if (stage == AUTO_WAIT_FIRST) return "wait_first";
+        if (stage == AUTO_WAIT_LAST) return "wait_last";
+        if (stage == AUTO_RUNNING) return "running";
+        if (stage == AUTO_DONE) return "done";
+        if (stage == AUTO_ERROR) return "error";
+        return "unknown";
+    }
+
+    private static void collectParticipantNames(JSONObject root, List<String> output) {
+        JSONObject lots = root.optJSONObject("lots");
+        if (lots == null) return;
+        for (String lotId : jsonKeys(lots)) {
+            JSONObject lot = lots.optJSONObject(lotId);
+            JSONArray comments = lot == null ? null : lot.optJSONArray("comments");
+            if (comments == null) continue;
+            for (int i = 0; i < comments.length(); i++) {
+                JSONObject comment = comments.optJSONObject(i);
+                if (comment == null) continue;
+                String name = comment.optString("name", "").trim();
+                if (name.length() > 0) output.add(name);
+            }
+        }
+    }
+
+    private static void collectDiagnosticNames(Object value, List<String> output) {
+        if (value instanceof JSONArray) {
+            JSONArray values = (JSONArray) value;
+            for (int i = 0; i < values.length(); i++) {
+                collectDiagnosticNames(values.opt(i), output);
+            }
+            return;
+        }
+        if (!(value instanceof JSONObject)) return;
+        JSONObject object = (JSONObject) value;
+        String viewId = object.optString("id", "").toLowerCase(Locale.US);
+        for (String key : jsonKeys(object)) {
+            Object child = object.opt(key);
+            if (("name".equalsIgnoreCase(key) || "participant".equalsIgnoreCase(key))
+                && child instanceof String && ((String) child).trim().length() > 0) {
+                output.add(((String) child).trim());
+            } else if ("text".equalsIgnoreCase(key) && child instanceof String
+                && isIdentityView(viewId)) {
+                output.add(((String) child).trim());
+            }
+            collectDiagnosticNames(child, output);
+        }
+    }
+
+    private static Object sanitizeDiagnosticValue(Object value, Map<String, String> aliases)
+        throws Exception {
+        if (value instanceof JSONArray) {
+            JSONArray source = (JSONArray) value;
+            JSONArray result = new JSONArray();
+            for (int i = 0; i < source.length(); i++) {
+                result.put(sanitizeDiagnosticValue(source.opt(i), aliases));
+            }
+            return result;
+        }
+        if (value instanceof JSONObject) {
+            JSONObject source = (JSONObject) value;
+            JSONObject result = new JSONObject();
+            String viewId = source.optString("id", "").toLowerCase(Locale.US);
+            for (String key : jsonKeys(source)) {
+                if (isPrivateDiagnosticKey(key)) continue;
+                Object child = source.opt(key);
+                if (child instanceof String && isStructuredLotId(key, (String) child)) {
+                    result.put(key, child);
+                } else if (("name".equalsIgnoreCase(key)
+                    || "participant".equalsIgnoreCase(key)) && child instanceof String) {
+                    result.put(key, DiagnosticAnonymizer.aliasFor((String) child, aliases));
+                } else if ("text".equalsIgnoreCase(key) && child instanceof String
+                    && isIdentityView(viewId)) {
+                    result.put(key, DiagnosticAnonymizer.aliasFor((String) child, aliases));
+                } else if ("description".equalsIgnoreCase(key) && child instanceof String
+                    && isProfileImageView(viewId)) {
+                    result.put(key, "[PROFILE_IMAGE]");
+                } else {
+                    result.put(key, sanitizeDiagnosticValue(child, aliases));
+                }
+            }
+            return result;
+        }
+        if (value instanceof String) {
+            return DiagnosticAnonymizer.sanitizeText((String) value, aliases);
+        }
+        return value == null ? JSONObject.NULL : value;
+    }
+
+    private static boolean isStructuredLotId(String key, String value) {
+        String normalized = key == null ? "" : key.toLowerCase(Locale.US);
+        boolean lotKey = normalized.equals("id") || normalized.equals("lotid")
+            || normalized.equals("firstlot") || normalized.equals("lastlot")
+            || normalized.equals("currentlot");
+        return lotKey && value != null && value.matches("[0-9]{1,18}");
+    }
+
+    private static boolean isPrivateDiagnosticKey(String key) {
+        String value = key == null ? "" : key.toLowerCase(Locale.US);
+        return value.equals("session") || value.equals("key") || value.equals("capturedat")
+            || value.equals("startedat") || value.equals("updatedat") || value.equals("seenat")
+            || value.equals("threadseenat") || value.equals("date");
+    }
+
+    private static boolean isIdentityView(String viewId) {
+        String value = viewId == null ? "" : viewId.toLowerCase(Locale.US);
+        return value.contains("contact_name") || value.contains("participant_name")
+            || value.contains("name_in_group") || value.contains("comment_header")
+            || value.contains("msg_from") || value.contains("sender_name")
+            || value.contains("author_name") || value.contains("profile_name");
+    }
+
+    private static boolean isProfileImageView(String viewId) {
+        String value = viewId == null ? "" : viewId.toLowerCase(Locale.US);
+        return value.contains("profile_pic") || value.contains("profile_photo")
+            || value.contains("contact_photo") || value.contains("profile_picture");
+    }
